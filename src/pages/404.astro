---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Page not found" description="That page is not in the YellowBird docs." documentTitle="Page not found · YellowBird docs" index={false}>
  <main class="mx-auto flex min-h-dvh max-w-lg flex-col justify-center px-6">
    <p class="text-sm text-neutral-500">404</p>
    <h1 class="mt-2 text-2xl font-medium">Page not found</h1>
    <p class="mt-3 text-sm leading-6 text-neutral-600">That URL is not a page in these docs.</p>
    <a class="mt-6 text-sm underline" href={import.meta.env.BASE_URL}>Back to the docs</a>
  </main>
</Layout>
