---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import interLatin from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  documentTitle?: string;
  index?: boolean;
}

const {
  title,
  description = 'Documentation for YellowBird, a Go media pipeline.',
  documentTitle,
  index = true,
} = Astro.props;

const site = Astro.site ?? new URL('https://yellowbird.amaanworks.me');
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = new URL(`${basePath}/`, site).href.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site);
const fullTitle = documentTitle ?? `${title} · YellowBird docs`;
const image = new URL(`${basePath}/og.png`, site);
const home = canonical.pathname === basePath;
const kind = home ? 'website' : 'article';

const crumbs = home
  ? []
  : [
      { name: 'Docs', item: siteUrl },
      { name: title, item: canonical.href },
    ];

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: 'YellowBird docs',
    url: siteUrl,
    description: 'Documentation for YellowBird, a Go media pipeline.',
    inLanguage: 'en',
    publisher: {
      '@type': 'Organization',
      name: 'YellowBird',
      url: 'https://github.com/dexisback/YellowBird',
    },
  },
];

if (index) {
  graph.push({
    '@type': 'TechArticle',
    '@id': `${canonical.href}#article`,
    headline: title,
    name: fullTitle,
    description,
    inLanguage: 'en',
    url: canonical.href,
    mainEntityOfPage: canonical.href,
    image: image.href,
    isPartOf: { '@id': `${siteUrl}#website` },
    about: {
      '@type': 'SoftwareSourceCode',
      name: 'YellowBird',
      programmingLanguage: 'Go',
      codeRepository: 'https://github.com/dexisback/YellowBird',
    },
  });

  if (crumbs.length > 1) {
    graph.push({
      '@type': 'BreadcrumbList',
      '@id': `${canonical.href}#breadcrumb`,
      itemListElement: crumbs.map((crumb, position) => ({
        '@type': 'ListItem',
        position: position + 1,
        name: crumb.name,
        item: crumb.item,
      })),
    });
  }
}

const jsonLdText = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll('<', '\\u003c');
const robots = index ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, follow';
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={`${basePath}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={kind} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="YellowBird docs" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="YellowBird docs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <meta name="twitter:image:alt" content="YellowBird docs" />
    {index ? <script type="application/ld+json" set:html={jsonLdText} /> : null}
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <slot />
  </body>
</html>
